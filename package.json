{
  "name": "dsh-github-tk",
  "version": "0.1.0",
  "type": "module",
  "description": "Direct GitHub repository tools and cloud projects for DeepSeek Harness",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
